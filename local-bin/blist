#!/bin/bash
# @DESC: ~/.local/bin 스크립트 목록 및 설명 출력

DIR="${HOME}/.local/bin"

BOLD="\033[1m"
BWHITE="\033[37m\033[36m"
WHITE="\033[37m"
RESET="\033[0m"



printf "${BOLD}%-30s %s${RESET}\n" "SCRIPT" "DESCRIPTION"


i=0
for f in "$DIR"/*; do
    [[ -f "$f" && -x "$f" ]] || continue
    name=$(basename "$f")
    desc=$(grep -im1 '^# @desc:' "$f" 2>/dev/null | sed 's/^[^:]*: *//')
    [[ -z "$desc" ]] && desc=""

    ((i++))
    if (( i % 2 == 0 )); then
        COLOR="$BWHITE"
    else
        COLOR="$WHITE"
    fi

    printf "${COLOR}%-30s %s${RESET}\n" "$name" "$desc"
done

